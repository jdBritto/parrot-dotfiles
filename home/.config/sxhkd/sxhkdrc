#
# wm independent hotkeys
#

# terminal emulator
super + Return
	/opt/kitty/bin/kitty

# program launcher
super + d
	/usr/bin/rofi -show run

# mostrar popup con la lista de atajos
super + h
	~/.config/bspwm/scripts/atajos

# make sxhkd reload its configuration files:
super + Escape
	pkill -USR1 -x sxhkd

#
# bspwm hotkeys
#

# quit bspwm (movido a super+alt+shift+q para no chocar con "matar ventana")
super + alt + shift + q
	bspc quit

# restart bspwm
super + shift + r
	bspc wm -r

# close and kill
super + {_,shift + }q
	bspc node -{c,k}

# alternate between the tiled and monocle layout
super + m
	bspc desktop -l next

# send the newest marked node to the newest preselected node
super + y
	bspc node newest.marked.local -n newest.!automatic.local

# swap the current node and the biggest window
super + g
	bspc node -s biggest.window

#
# state/flags
#

# set the window state
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

#
# focus/swap
#

# focus the node in the given direction
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# focus the next/previous window in the current desktop
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# focus the next/previous desktop in the current monitor
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# focus the last node/desktop
super + {grave,Tab}
	bspc {node,desktop} -f last

# focus the older or newer node in the focus history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# focus or send to the given desktop
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#
# preselect
#

# preselect the direction
super + ctrl + alt + {Left,Down,Up,Right}
	bspc node -p {west,south,north,east}

# preselect the ratio
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# cancel the preselection for the focused node
super + ctrl + alt + space
	bspc node -p cancel

# cancel the preselection for the focused desktop
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#

# move a floating window (movido a super+ctrl para no chocar con "intercambiar ventana")
super + ctrl + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}

# Custom Resize
super + alt + {Left,Down,Up,Right}
	~/.config/bspwm/scripts/bspwm_resize {west,south,north,east}

#Open FIrefox
super + shift + f
	/usr/bin/firefox
  
# i3lock-fancy
#super + shift + x
#  /usr/bin/i3lock-fancy
# bloqueo con animación Matrix
super + shift + x
        ~/.config/xsecurelock/lock.sh


# fijar/borrar la máquina objetivo de la polybar (popup)
super + shift + v
	~/.config/bspwm/scripts/settarget_popup

# cambiador de ventanas
super + w
        /usr/bin/rofi -show window
# historial de portapapeles
super + v
        ~/.config/rofi/scripts/clipboard.sh

#
# ---- Añadidos 2026-11-03 (mismos atajos que en Niri cuando no chocan)
#

# buscar aplicaciones con iconos (como Mod+Space en Niri)
super + space
	rofi -show drun

# elegir fondo: cambia también los colores de todo el escritorio
super + ctrl + space
	~/.local/bin/fondo

# menú de apagado / bloqueo / cerrar sesión
super + shift + Escape
	~/.config/rofi/scripts/apagar.sh

# capturas: área | pantalla completa | ventana activa
Print
	~/.config/bspwm/scripts/captura area
shift + Print
	~/.config/bspwm/scripts/captura pantalla
super + Print
	~/.config/bspwm/scripts/captura ventana

# notificaciones: ver la última otra vez | borrar todas
super + n
	dunstctl history-pop
super + shift + comma
	dunstctl close-all

# volumen
XF86Audio{RaiseVolume,LowerVolume}
	pactl set-sink-volume @DEFAULT_SINK@ {+5%,-5%}
XF86AudioMute
	pactl set-sink-mute @DEFAULT_SINK@ toggle

