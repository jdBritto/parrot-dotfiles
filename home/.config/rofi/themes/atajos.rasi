/* Tema del visor de atajos (Super + H). Colores: ../colores.rasi (matugen) */
@import "~/.config/rofi/colores.rasi"

* {
    bg0:    @bg;
    bg1:    @bg-alt;
    bg2:    @bg-sel;
    bg3:    @muted;
    fg0:    @fg;
    fg1:    @fg;
    fg2:    @muted;
    accent: @accent;

    font:   "Hack Nerd Font Mono 11";
    background-color:   transparent;
    text-color:         @fg0;
    margin:  0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location:       center;
    anchor:         center;
    x-offset:       0;
    y-offset:       0;
    width:          960px;
    border:         2px;
    border-color:   @bg3;
    border-radius:  20px;
    background-color: @bg0;
}

mainbox {
    padding:  18px;
    spacing:  12px;
    children: [ inputbar, message, listview ];
}

inputbar {
    background-color: @bg1;
    border:           2px;
    border-color:     @accent;
    border-radius:    14px;
    padding:          10px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt {
    text-color: @accent;
    font:       "Hack Nerd Font Bold 13";
}

entry {
    placeholder:       "Buscar atajo, acción o sección…";
    placeholder-color: @fg2;
    cursor:            text;
}

message {
    background-color: @bg2;
    border-radius:    12px;
    padding:          8px 16px;
}

textbox {
    text-color: @fg2;
    font:       "Hack Nerd Font Mono 10";
}

listview {
    lines:        16;
    columns:      1;
    fixed-height: true;
    scrollbar:    true;
    spacing:      2px;
}

scrollbar {
    handle-width:     4px;
    handle-color:     @bg3;
    border-radius:    4px;
    margin:           0 0 0 8px;
}

element {
    padding:       7px 14px;
    border-radius: 10px;
}

element normal.normal,
element alternate.normal {
    background-color: transparent;
}

element selected.normal {
    background-color: @bg2;
    border:           0 0 0 3px;
    border-color:     @accent;
}

element-text {
    text-color:       inherit;
    highlight:        bold underline;
    vertical-align:   0.5;
}
