#!/bin/sh
# BSPWM — Parrot. Los colores salen del fondo (comando "fondo"), los mismos de Niri/DMS.
# Respaldo de la versión anterior: ~/.config-respaldo-bspwm-20261103/

CFG="$HOME/.config"
corre() { pgrep -x "$1" >/dev/null; }   # corre <proceso>
tiene() { command -v "$1" >/dev/null; } # tiene <programa>

# ---------------------------------------------------------------- entorno
export _JAVA_AWT_WM_NONREPARENTING=1   # Burp Suite, Ghidra, ZAP... sin ventanas grises
export PATH="$HOME/.local/bin:$PATH"
xsetroot -cursor_name left_ptr

# ---------------------------------------------------------------- escritorios
bspc monitor -d I II III IV V VI VII VIII IX X

# ---------------------------------------------------------------- aspecto
# Paleta generada por matugen (valores por defecto por si aún no existe).
ACENTO="#44ABFF"; BORDE_INACTIVO="#232A38"; TERCIARIO="#44ABFF"
[ -r "$CFG/bspwm/colores.sh" ] && . "$CFG/bspwm/colores.sh"

bspc config border_width          2
bspc config window_gap            12
bspc config focused_border_color  "$ACENTO"
bspc config active_border_color   "$BORDE_INACTIVO"
bspc config normal_border_color   "$BORDE_INACTIVO"
bspc config presel_feedback_color "$TERCIARIO"

bspc config split_ratio           0.52
bspc config automatic_scheme      alternate   # divide como Hyprland (espiral equilibrada)
bspc config borderless_monocle    true
bspc config gapless_monocle       true
bspc config single_monocle        false

# ---------------------------------------------------------------- ratón
bspc config pointer_modifier      mod4        # Super + arrastrar = mover / redimensionar
bspc config pointer_action1       move
bspc config pointer_action3       resize_corner
bspc config focus_follows_pointer false
bspc config click_to_focus        any

# ---------------------------------------------------------------- reglas
bspc rule -r '*'
bspc rule -a Gimp              desktop='^8' state=floating follow=on
bspc rule -a Chromium          desktop='^2'
bspc rule -a firefox           desktop='^2'
bspc rule -a burp-StartBurp    desktop='^3' follow=on
bspc rule -a 'Burp Suite Community Edition' desktop='^3' follow=on
bspc rule -a Wireshark         desktop='^4'
bspc rule -a mplayer2          state=floating
bspc rule -a Pavucontrol       state=floating center=on
bspc rule -a Nm-connection-editor state=floating center=on
bspc rule -a Blueman-manager   state=floating center=on
bspc rule -a copyq             state=floating center=on
bspc rule -a KeePassXC         state=floating center=on
bspc rule -a Galculator        state=floating
bspc rule -a 'Org.gnome.Calculator' state=floating
bspc rule -a Kupfer.py         focus=on
bspc rule -a Screenkey         manage=off
bspc rule -a Zathura           state=tiled

# ---------------------------------------------------------------- arranque
corre sxhkd || sxhkd &

# fondo: el último elegido con "fondo". La primera vez (equipo nuevo) se elige
# uno y se generan sus colores, que necesitan la polybar y rofi.
if [ -x "$HOME/.fehbg" ] && [ -f "$CFG/polybar/colores-tema.ini" ]; then
    "$HOME/.fehbg" &
else
    for img in "$HOME/Desktop/Background/wallpappers_1.jpg" /usr/share/backgrounds/default.jpg; do
        [ -f "$img" ] && break
    done
    "$HOME/.local/bin/fondo" "$img"
    . "$CFG/bspwm/colores.sh" 2>/dev/null && bspc config focused_border_color "$ACENTO"
fi

corre picom || picom &
"$CFG/polybar/launch.sh" &

# Integración con la VM (portapapeles y tamaño de pantalla). QEMU/KVM o VMware.
tiene spice-vdagent && { corre spice-vdagent || spice-vdagent; }
tiene vmware-user-suid-wrapper && vmware-user-suid-wrapper &

# Ventanas de contraseña (montar discos, pkexec, NetworkManager...)
for agente in /usr/libexec/polkit-mate-authentication-agent-1 \
              /usr/lib/policykit-1-gnome/polkit-gnome-authentication-agent-1; do
    [ -x "$agente" ] && { pgrep -f "$(basename "$agente")" >/dev/null || "$agente" & break; }
done

tiene dunst && { corre dunst || dunst & }
tiene copyq && { corre copyq || copyq & }

# Bloqueo automático a los 10 min y al suspender (xsecurelock con animación Matrix)
xset s 600 600
tiene xss-lock && { corre xss-lock || xss-lock -l -- "$CFG/xsecurelock/lock.sh" & }
